{
  "name": "@fooplugins/foopixel-fx",
  "version": "1.3.0",
  "description": "Pixel hover effects, bursts and progress bars for drop zones and buttons, based on the FooPixel logo.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/foopixel-fx.min.js",
  "module": "dist/foopixel-fx.esm.min.js",
  "types": "dist/foopixel-fx.d.ts",
  "exports": {
    ".": {
      "types": "./dist/foopixel-fx.d.ts",
      "import": "./dist/foopixel-fx.esm.min.js",
      "default": "./dist/foopixel-fx.min.js"
    },
    "./progress": {
      "types": "./dist/foopixel-fx-progress.d.ts",
      "import": "./dist/foopixel-fx-progress.esm.min.js",
      "default": "./dist/foopixel-fx-progress.min.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/foopixel-fx-progress.js",
    "./dist/foopixel-fx-progress.min.js",
    "./dist/foopixel-fx-progress.esm.js",
    "./dist/foopixel-fx-progress.esm.min.js"
  ],
  "scripts": {
    "build": "sh build.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fooplugins/foopixel-fx.git"
  },
  "homepage": "https://github.com/fooplugins/foopixel-fx#readme",
  "bugs": {
    "url": "https://github.com/fooplugins/foopixel-fx/issues"
  }
}
